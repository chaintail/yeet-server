# Import inside the existing loopback Cloudflare-origin server block (the :18080 server).
# cf_https_proto must keep the existing trusted Cloudflare HTTPS behaviour.
# Route table: port plan section 1.7. AS on 127.0.0.1:38860, connector on 127.0.0.1:38861.
@yeet_conn host chatgpt.yeet.win
handle @yeet_conn {
	header {
		Cache-Control "no-store"
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self' https://chatgpt.com"
	}
	@yeet_private path /policy /policy/* /admin /admin/* /operator /operator/* /dev /dev/* /test /test/* /core /core/*
	handle @yeet_private {
		respond 404
	}
	@yeet_protocol {
		method POST
		path /
	}
	handle @yeet_protocol {
		reverse_proxy 127.0.0.1:38861 {
			import cf_https_proto
		}
	}
	# Public deployment facts (commit, vendored yeet-win pin, trading state, limits); the connector caches them 60 s.
	@yeet_version {
		method GET HEAD
		path /version
	}
	handle @yeet_version {
		header >Cache-Control "public, max-age=60"
		reverse_proxy 127.0.0.1:38861 {
			import cf_https_proto
		}
	}
	# Card signing (connector/as/sign-page.mjs, served by the sign-in server). The trade card loads the Privy signer
	# cross-origin from its sandbox origin; the hashed name never changes content, so it is cached a year. `>` replaces
	# the blanket no-store above (otherwise both values go out and no-store wins). /sign sets its own CSP, so the `?`
	# default above stays off there; it keeps no-store.
	@yeet_signer_hashed {
		method GET HEAD
		path_regexp ^/cards/yeet-signer-[0-9a-f]{12}\.js$
	}
	handle @yeet_signer_hashed {
		header >Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy 127.0.0.1:38860 {
			import cf_https_proto
		}
	}
	@yeet_signer_stable {
		method GET HEAD
		path /cards/yeet-signer.js
	}
	handle @yeet_signer_stable {
		header >Cache-Control "public, max-age=300"
		reverse_proxy 127.0.0.1:38860 {
			import cf_https_proto
		}
	}
	@yeet_connector_get {
		method GET HEAD
		path /.well-known/oauth-protected-resource /health
	}
	handle @yeet_connector_get {
		reverse_proxy 127.0.0.1:38861 {
			import cf_https_proto
		}
	}
	# Everything else, including GET /, goes to the sign-in server: OAuth/OIDC endpoints, /me, /interaction/*, /account/*.
	handle {
		reverse_proxy 127.0.0.1:38860 {
			import cf_https_proto
		}
	}
}

# Landing page (built yeet-win apps/landing).
@yeet_landing host yeet.win www.yeet.win
handle @yeet_landing {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
	}
	root * /srv/yeet-win/apps/landing
	file_server
}
