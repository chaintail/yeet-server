# Copy to ops/.env (git-ignored) and fill in. Non-secret settings only; compose interpolates these.
YEET_IMAGE_TAG=
ISSUER=
RESOURCE=
PUBLIC_BASE_URL=
PUBLIC_MODE=
COOKIE_SECURE=
TRUST_PROXY=
ACCESS_TTL=
REFRESH_FAMILY_TTL=604800
TEST_PROFILE=
DEV_IDENTITY_STUB=
MOCK_PASSWORD_LOGIN=
PRIVY_LOGIN=
REFRESH_CONSENT_COMPAT=1
REFRESH_DIAGNOSTICS=1
CIMD_TEST_FIXTURES=
PRIVY_APP_ID=
PRIVY_JWKS_URL=
# Sign-in methods on pages with no account-bound link: google, apple, email (comma list). Empty = google,apple.
YEET_LOGIN_METHODS=
AS_INTERNAL=
CORE_INTERNAL=
YEET_SIGNER_ID=
YEET_BASE_POLICY_ID=
YEET_SOLANA_POLICY_ID=
YEET_PRIVY_KEY_QUORUM_ID=
YEET_SIGNER=
YEET_GAS_WALLET_ID=
# Base gas: sponsor (default, Privy gas sponsorship) or self (unsponsored; the wallet pays from its own ETH).
YEET_BASE_GAS=
YEET_SOL_FEE_PAYER_ID=
BASE_RPC_URL=
SOLANA_RPC_URL=
YEET_LIVE=
YEET_KILL_SWITCH=
# Comma list of account ids (yeet-privy-...) that may trade while live; empty = every account. See ops/FIRST-TRADE.md.
YEET_LIVE_ACCOUNTS=
YEET_MAX_TRADE_USDC=
YEET_DAILY_CAP_USDC=
YEET_MIN_LEG_USDC=
YEET_MAX_COST_BPS=
YEET_MAX_ACCOUNTS=
YEET_REQUOTE_TOLERANCE_BPS=
YEET_CODE_MINT_LIMIT=
