{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "description": "YEET tool contract, P0 tools. Local stand-in until yeet-win publishes contracts/yeet-tools.json (see vendor/README.md).",
 "$defs": {
  "usdc": {
   "type": "string",
   "pattern": "^(0|[1-9][0-9]{0,5})(\\.[0-9]{1,6})?$"
  },
  "symbol": {
   "type": "string",
   "pattern": "^[A-Z0-9]{2,12}$"
  },
  "proposal_id": {
   "type": "string",
   "pattern": "^p_[a-z0-9]{20}$"
  },
  "trade_id": {
   "type": "string",
   "pattern": "^t_[a-z0-9]{20}$"
  },
  "request_id": {
   "type": "string",
   "minLength": 1,
   "maxLength": 64
  },
  "amount": {
   "type": "string",
   "minLength": 1,
   "maxLength": 40
  },
  "leg_in": {
   "type": "object",
   "properties": {
    "symbol": {
     "$ref": "#/$defs/symbol"
    },
    "parts": {
     "type": "integer",
     "minimum": 1,
     "maximum": 10
    }
   },
   "required": [
    "symbol",
    "parts"
   ],
   "additionalProperties": false
  },
  "quote_leg": {
   "type": "object",
   "properties": {
    "symbol": {
     "$ref": "#/$defs/symbol"
    },
    "parts": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 1,
       "maximum": 10
      },
      {
       "type": "null"
      }
     ]
    },
    "amount_in": {
     "$ref": "#/$defs/amount"
    },
    "est_out": {
     "$ref": "#/$defs/amount"
    },
    "est_out_usd": {
     "anyOf": [
      {
       "$ref": "#/$defs/usdc"
      },
      {
       "type": "null"
      }
     ]
    },
    "min_out": {
     "$ref": "#/$defs/amount"
    }
   },
   "required": [
    "symbol",
    "parts",
    "amount_in",
    "est_out",
    "est_out_usd",
    "min_out"
   ],
   "additionalProperties": false
  },
  "proposal": {
   "type": "object",
   "properties": {
    "proposal_id": {
     "$ref": "#/$defs/proposal_id"
    },
    "revision": {
     "type": "integer",
     "minimum": 1
    },
    "direction": {
     "enum": [
      "yeet",
      "skeet"
     ]
    },
    "amount_usdc": {
     "$ref": "#/$defs/usdc"
    },
    "legs": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/quote_leg"
     },
     "minItems": 1,
     "maxItems": 5
    },
    "totals": {
     "type": "object",
     "properties": {
      "in_usd": {
       "$ref": "#/$defs/usdc"
      },
      "out_usd": {
       "$ref": "#/$defs/usdc"
      },
      "cost_pct": {
       "type": "number",
       "minimum": 0,
       "maximum": 100
      },
      "time_estimate_s": {
       "type": "integer",
       "minimum": 0
      }
     },
     "required": [
      "in_usd",
      "out_usd",
      "cost_pct",
      "time_estimate_s"
     ],
     "additionalProperties": false
    },
    "quoted_at": {
     "type": "string",
     "minLength": 1,
     "maxLength": 40
    },
    "warnings": {
     "type": "array",
     "items": {
      "enum": [
       "COST_HIGH",
       "LEG_SMALL",
       "BALANCE_LOW",
       "SIGNER_MISSING"
      ]
     },
     "maxItems": 4,
     "uniqueItems": true
    },
    "next": {
     "const": "Tap ⚡ YEET in the card"
    }
   },
   "required": [
    "proposal_id",
    "revision",
    "direction",
    "amount_usdc",
    "legs",
    "totals",
    "quoted_at",
    "warnings",
    "next"
   ],
   "additionalProperties": false
  },
  "failure": {
   "type": "object",
   "properties": {
    "error": {
     "enum": [
      "INVALID_ARGUMENT",
      "COIN_NOT_SUPPORTED",
      "PARTS_NOT_TEN",
      "AMOUNT_TOO_SMALL",
      "COST_TOO_HIGH",
      "LIMIT_EXCEEDED",
      "BALANCE_LOW",
      "WALLET_NOT_READY",
      "CONFIRMATION_REQUIRED",
      "REQUOTE_REQUIRED",
      "TRADING_PAUSED",
      "REAUTH_REQUIRED",
      "TEMPORARILY_UNAVAILABLE"
     ]
    },
    "message": {
     "type": "string",
     "minLength": 1,
     "maxLength": 300
    },
    "retryable": {
     "type": "boolean"
    }
   },
   "required": [
    "error",
    "message",
    "retryable"
   ],
   "additionalProperties": false
  },
  "empty": {
   "type": "object",
   "properties": {},
   "required": [],
   "additionalProperties": false
  },
  "home": {
   "type": "object",
   "properties": {
    "wallets": {
     "type": "object",
     "properties": {
      "base": {
       "type": "object",
       "properties": {
        "address": {
         "type": "string",
         "minLength": 1,
         "maxLength": 64
        },
        "usdc": {
         "anyOf": [
          {
           "$ref": "#/$defs/usdc"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "address",
        "usdc"
       ],
       "additionalProperties": false
      },
      "solana": {
       "type": "object",
       "properties": {
        "address": {
         "type": "string",
         "minLength": 1,
         "maxLength": 64
        }
       },
       "required": [
        "address"
       ],
       "additionalProperties": false
      }
     },
     "required": [
      "base",
      "solana"
     ],
     "additionalProperties": false
    },
    "ready": {
     "enum": [
      "ready",
      "needs_signer",
      "needs_funds",
      "paused"
     ]
    },
    "xp": {
     "anyOf": [
      {
       "type": "object",
       "properties": {
        "total": {
         "type": "integer",
         "minimum": 0
        },
        "streak_days": {
         "type": "integer",
         "minimum": 0
        },
        "spin_available": {
         "type": "boolean"
        }
       },
       "required": [
        "total",
        "streak_days",
        "spin_available"
       ],
       "additionalProperties": false
      },
      {
       "type": "null"
      }
     ]
    },
    "recent_wins": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "symbol": {
        "$ref": "#/$defs/symbol"
       },
       "pct": {
        "type": "number"
       },
       "at": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
       }
      },
      "required": [
       "symbol",
       "pct",
       "at"
      ],
      "additionalProperties": false
     },
     "maxItems": 3
    }
   },
   "required": [
    "wallets",
    "ready",
    "xp",
    "recent_wins"
   ],
   "additionalProperties": false
  },
  "coins": {
   "type": "object",
   "properties": {
    "coins": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "symbol": {
        "$ref": "#/$defs/symbol"
       },
       "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       },
       "kind": {
        "enum": [
         "meme",
         "major"
        ]
       },
       "price_usd": {
        "anyOf": [
         {
          "type": "number",
          "minimum": 0
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "symbol",
       "name",
       "kind",
       "price_usd"
      ],
      "additionalProperties": false
     },
     "maxItems": 25
    },
    "limits": {
     "type": "object",
     "properties": {
      "min_leg_usdc": {
       "$ref": "#/$defs/usdc"
      },
      "max_trade_usdc": {
       "$ref": "#/$defs/usdc"
      },
      "max_legs": {
       "type": "integer",
       "minimum": 1,
       "maximum": 5
      },
      "default_usdc": {
       "$ref": "#/$defs/usdc"
      }
     },
     "required": [
      "min_leg_usdc",
      "max_trade_usdc",
      "max_legs",
      "default_usdc"
     ],
     "additionalProperties": false
    }
   },
   "required": [
    "coins",
    "limits"
   ],
   "additionalProperties": false
  },
  "propose": {
   "type": "object",
   "properties": {
    "request_id": {
     "$ref": "#/$defs/request_id"
    },
    "amount_usdc": {
     "$ref": "#/$defs/usdc"
    },
    "legs": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/leg_in"
     },
     "minItems": 1,
     "maxItems": 5
    },
    "slippage_bps": {
     "type": "integer",
     "minimum": 50,
     "maximum": 300
    }
   },
   "required": [
    "request_id",
    "amount_usdc",
    "legs"
   ],
   "additionalProperties": false
  },
  "quote": {
   "type": "object",
   "properties": {
    "proposal_id": {
     "$ref": "#/$defs/proposal_id"
    },
    "legs": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/leg_in"
     },
     "minItems": 1,
     "maxItems": 5
    },
    "amount_usdc": {
     "$ref": "#/$defs/usdc"
    }
   },
   "required": [
    "proposal_id"
   ],
   "additionalProperties": false
  },
  "execute": {
   "type": "object",
   "properties": {
    "proposal_id": {
     "$ref": "#/$defs/proposal_id"
    },
    "revision": {
     "type": "integer",
     "minimum": 1
    },
    "confirm": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{43}$"
    }
   },
   "required": [
    "proposal_id",
    "revision",
    "confirm"
   ],
   "additionalProperties": false
  },
  "executed": {
   "type": "object",
   "properties": {
    "trade_id": {
     "$ref": "#/$defs/trade_id"
    },
    "proposal_id": {
     "$ref": "#/$defs/proposal_id"
    },
    "direction": {
     "enum": [
      "yeet",
      "skeet"
     ]
    },
    "status": {
     "enum": [
      "submitted",
      "requote_required"
     ]
    },
    "legs": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "symbol": {
        "$ref": "#/$defs/symbol"
       },
       "deposit_address": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
       },
       "tx_hash": {
        "anyOf": [
         {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
         },
         {
          "type": "null"
         }
        ]
       },
       "explorer_url": {
        "anyOf": [
         {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
         },
         {
          "type": "null"
         }
        ]
       },
       "status": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
       }
      },
      "required": [
       "symbol",
       "deposit_address",
       "tx_hash",
       "explorer_url",
       "status"
      ],
      "additionalProperties": false
     },
     "maxItems": 5
    },
    "requote": {
     "$ref": "#/$defs/proposal"
    }
   },
   "required": [
    "trade_id",
    "proposal_id",
    "direction",
    "status",
    "legs"
   ],
   "additionalProperties": false
  },
  "status_input": {
   "type": "object",
   "properties": {
    "trade_id": {
     "$ref": "#/$defs/trade_id"
    }
   },
   "required": [
    "trade_id"
   ],
   "additionalProperties": false
  },
  "status": {
   "type": "object",
   "properties": {
    "trade_id": {
     "$ref": "#/$defs/trade_id"
    },
    "direction": {
     "enum": [
      "yeet",
      "skeet"
     ]
    },
    "status": {
     "enum": [
      "signing",
      "submitted",
      "settling",
      "success",
      "partial",
      "refunded",
      "failed"
     ]
    },
    "legs": {
     "type": "array",
     "maxItems": 5,
     "items": {
      "type": "object",
      "properties": {
       "symbol": {
        "$ref": "#/$defs/symbol"
       },
       "status": {
        "enum": [
         "PENDING_DEPOSIT",
         "KNOWN_DEPOSIT_TX",
         "INCOMPLETE_DEPOSIT",
         "PROCESSING",
         "SUCCESS",
         "REFUNDED",
         "FAILED"
        ]
       },
       "amount_in": {
        "$ref": "#/$defs/amount"
       },
       "amount_out": {
        "anyOf": [
         {
          "$ref": "#/$defs/amount"
         },
         {
          "type": "null"
         }
        ]
       },
       "origin_tx": {
        "anyOf": [
         {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
         },
         {
          "type": "null"
         }
        ]
       },
       "destination_tx": {
        "anyOf": [
         {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
         },
         {
          "type": "null"
         }
        ]
       },
       "refund_reason": {
        "anyOf": [
         {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "symbol",
       "status",
       "amount_in",
       "amount_out",
       "origin_tx",
       "destination_tx",
       "refund_reason"
      ],
      "additionalProperties": false
     }
    },
    "received": {
     "type": "array",
     "maxItems": 5,
     "items": {
      "type": "object",
      "properties": {
       "symbol": {
        "$ref": "#/$defs/symbol"
       },
       "amount": {
        "$ref": "#/$defs/amount"
       }
      },
      "required": [
       "symbol",
       "amount"
      ],
      "additionalProperties": false
     }
    },
    "updated_at": {
     "type": "string",
     "minLength": 1,
     "maxLength": 40
    },
    "xp_award": {
     "anyOf": [
      {
       "type": "object",
       "properties": {
        "points": {
         "type": "integer",
         "minimum": 0
        },
        "total": {
         "type": "integer",
         "minimum": 0
        }
       },
       "required": [
        "points",
        "total"
       ],
       "additionalProperties": false
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "trade_id",
    "direction",
    "status",
    "legs",
    "received",
    "updated_at",
    "xp_award"
   ],
   "additionalProperties": false
  }
 },
 "tools": {
  "yeet_home": {
   "input": "empty",
   "output": "home"
  },
  "yeet_coins": {
   "input": "empty",
   "output": "coins"
  },
  "yeet_propose": {
   "input": "propose",
   "output": "proposal"
  },
  "yeet_quote": {
   "input": "quote",
   "output": "proposal"
  },
  "execute_trade": {
   "input": "execute",
   "output": "executed"
  },
  "trade_status": {
   "input": "status_input",
   "output": "status"
  }
 },
 "x-yeet-errors": {
  "description": "Tool error catalogue: message is model-facing, card is [title, body] for the widget.",
  "tool": {
   "INVALID_ARGUMENT": {
    "retryable": false,
    "message": "The request was not valid. Check the coins, parts and amount, then try again.",
    "card": [
     "Check the basket",
     "Something in this basket is not valid. Try different coins or amounts."
    ]
   },
   "COIN_NOT_SUPPORTED": {
    "retryable": false,
    "message": "That coin is not in the YEET list. Call yeet_coins and pick from it.",
    "card": [
     "Coin not available",
     "YEET cannot trade that coin yet. Pick one from the list."
    ]
   },
   "PARTS_NOT_TEN": {
    "retryable": false,
    "message": "Parts must be whole numbers that add up to 10.",
    "card": [
     "Parts must add up to 10",
     "Adjust the parts so they add up to 10."
    ]
   },
   "AMOUNT_TOO_SMALL": {
    "retryable": false,
    "message": "Each coin needs at least the minimum amount. Use fewer coins or a larger amount.",
    "card": [
     "Amount too small",
     "Use fewer coins or a larger amount."
    ]
   },
   "COST_TOO_HIGH": {
    "retryable": false,
    "message": "Fees for this basket are too high right now. Try a larger amount or fewer coins.",
    "card": [
     "Fees too high",
     "Fees are too high for this basket right now. Try a larger amount or fewer coins."
    ]
   },
   "LIMIT_EXCEEDED": {
    "retryable": false,
    "message": "This is over the per-trade or daily limit.",
    "card": [
     "Over the limit",
     "This is over your per-trade or daily limit."
    ]
   },
   "BALANCE_LOW": {
    "retryable": false,
    "message": "Not enough USDC in the YEET wallet for this basket.",
    "card": [
     "Not enough USDC",
     "Add USDC to your YEET wallet, then try again."
    ]
   },
   "WALLET_NOT_READY": {
    "retryable": false,
    "message": "The YEET wallet is not ready yet. The person finishes setup in the card.",
    "card": [
     "Wallet not ready",
     "Finish setting up your YEET wallet, then try again."
    ]
   },
   "CONFIRMATION_REQUIRED": {
    "retryable": false,
    "message": "Only the person can start a trade, by tapping ⚡ YEET in the card.",
    "card": [
     "Tap to confirm",
     "Only your ⚡ YEET tap can start a trade."
    ]
   },
   "REQUOTE_REQUIRED": {
    "retryable": false,
    "message": "Prices moved. The person refreshes the quote in the card.",
    "card": [
     "Prices moved",
     "Refresh the quote, then tap ⚡ YEET again."
    ]
   },
   "TRADING_PAUSED": {
    "retryable": true,
    "message": "Trading is paused right now. Try again later.",
    "card": [
     "Trading paused",
     "Trading is paused right now. Try again later."
    ]
   },
   "REAUTH_REQUIRED": {
    "retryable": false,
    "message": "Reconnect YEET in ChatGPT, then try again.",
    "card": [
     "Reconnect YEET",
     "ChatGPT needs your permission again. Reconnect YEET when ChatGPT asks, then try again."
    ]
   },
   "TEMPORARILY_UNAVAILABLE": {
    "retryable": true,
    "message": "YEET is temporarily unavailable. Try again shortly.",
    "card": [
     "YEET is busy",
     "Try again in a minute."
    ]
   }
  },
  "unknown": "TEMPORARILY_UNAVAILABLE",
  "passThrough": [
   "INVALID_ARGUMENT",
   "COIN_NOT_SUPPORTED",
   "PARTS_NOT_TEN",
   "AMOUNT_TOO_SMALL",
   "COST_TOO_HIGH",
   "LIMIT_EXCEEDED",
   "BALANCE_LOW",
   "WALLET_NOT_READY",
   "CONFIRMATION_REQUIRED",
   "REQUOTE_REQUIRED",
   "TRADING_PAUSED",
   "REAUTH_REQUIRED"
  ]
 }
}
