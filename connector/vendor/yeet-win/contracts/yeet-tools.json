{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YEET tool contract",
  "version": "1.0.0",
  "$defs": {
    "usdc": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})(\\.[0-9]{1,6})?$",
      "description": "USDC amount as a decimal string, up to 6 decimals."
    },
    "amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,18})?$",
      "description": "Token amount as a decimal string."
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,12}$",
      "description": "Coin symbol from yeet_coins."
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^p_[a-z0-9]{20}$"
    },
    "trade_id": {
      "type": "string",
      "pattern": "^t_[a-z0-9]{20}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Any new id per request; repeat it to retry safely."
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "description": "UTC time, ISO 8601."
    },
    "base_address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "solana_address": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "tx_hash": {
      "type": "string",
      "pattern": "^(0x[0-9a-fA-F]{64}|[1-9A-HJ-NP-Za-km-z]{43,90})$"
    },
    "https_url": {
      "type": "string",
      "pattern": "^https://[^\\s]{1,500}$"
    },
    "direction": {
      "enum": [
        "yeet",
        "skeet"
      ]
    },
    "swap_status": {
      "enum": [
        "PENDING_DEPOSIT",
        "KNOWN_DEPOSIT_TX",
        "INCOMPLETE_DEPOSIT",
        "PROCESSING",
        "SUCCESS",
        "REFUNDED",
        "FAILED"
      ],
      "description": "Swap status from NEAR Intents 1Click."
    },
    "warning": {
      "enum": [
        "COST_HIGH",
        "LEG_SMALL",
        "BALANCE_LOW",
        "SIGNER_MISSING"
      ]
    },
    "confirm": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "One-time code from the card; never shown to the model."
    },
    "confirm_meta": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/confirm"
        },
        "expires_at": {
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "code",
        "expires_at"
      ],
      "additionalProperties": false,
      "description": "Result _meta \"yeet/confirm\": read by the card only."
    },
    "leg_in": {
      "type": "object",
      "properties": {
        "symbol": {
          "$ref": "#/$defs/symbol"
        },
        "parts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Whole parts out of 10."
        }
      },
      "required": [
        "symbol",
        "parts"
      ],
      "additionalProperties": false
    },
    "quote_leg": {
      "type": "object",
      "properties": {
        "symbol": {
          "$ref": "#/$defs/symbol"
        },
        "parts": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            {
              "type": "null"
            }
          ]
        },
        "amount_in": {
          "$ref": "#/$defs/amount",
          "description": "What this leg spends: USDC for yeet, the coin for skeet."
        },
        "est_out": {
          "$ref": "#/$defs/amount"
        },
        "est_out_usd": {
          "$ref": "#/$defs/usdc"
        },
        "min_out": {
          "$ref": "#/$defs/amount"
        }
      },
      "required": [
        "symbol",
        "parts",
        "amount_in",
        "est_out",
        "est_out_usd",
        "min_out"
      ],
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "$ref": "#/$defs/proposal_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "direction": {
          "$ref": "#/$defs/direction"
        },
        "amount_usdc": {
          "$ref": "#/$defs/usdc"
        },
        "legs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quote_leg"
          },
          "minItems": 1,
          "maxItems": 5
        },
        "totals": {
          "type": "object",
          "properties": {
            "in_usd": {
              "$ref": "#/$defs/usdc"
            },
            "out_usd": {
              "$ref": "#/$defs/usdc"
            },
            "cost_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "time_estimate_s": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "in_usd",
            "out_usd",
            "cost_pct",
            "time_estimate_s"
          ],
          "additionalProperties": false
        },
        "quoted_at": {
          "$ref": "#/$defs/time"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          },
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true
        },
        "next": {
          "enum": [
            "Tap ⚡ YEET in the card",
            "Tap SKEET in the card"
          ]
        }
      },
      "required": [
        "proposal_id",
        "revision",
        "direction",
        "amount_usdc",
        "legs",
        "totals",
        "quoted_at",
        "warnings",
        "next"
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "properties": {
        "error": {
          "enum": [
            "INVALID_ARGUMENT",
            "COIN_NOT_SUPPORTED",
            "PARTS_NOT_TEN",
            "AMOUNT_TOO_SMALL",
            "COST_TOO_HIGH",
            "LIMIT_EXCEEDED",
            "BALANCE_LOW",
            "WALLET_NOT_READY",
            "CONFIRMATION_REQUIRED",
            "REQUOTE_REQUIRED",
            "TRADING_PAUSED",
            "REAUTH_REQUIRED",
            "TEMPORARILY_UNAVAILABLE"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "error",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "empty": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  "tools": {
    "yeet_home": {
      "priority": "P0",
      "title": "YEET home",
      "description": "Shows whether the person's YEET account is ready to trade, their USDC and their XP.",
      "inputSchema": {
        "$ref": "#/$defs/empty"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "wallets": {
            "type": "object",
            "properties": {
              "base": {
                "type": "object",
                "properties": {
                  "address": {
                    "$ref": "#/$defs/base_address"
                  },
                  "usdc": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/usdc"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "address",
                  "usdc"
                ],
                "additionalProperties": false
              },
              "solana": {
                "type": "object",
                "properties": {
                  "address": {
                    "$ref": "#/$defs/solana_address"
                  }
                },
                "required": [
                  "address"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "base",
              "solana"
            ],
            "additionalProperties": false
          },
          "ready": {
            "enum": [
              "ready",
              "needs_signer",
              "needs_funds",
              "paused"
            ]
          },
          "xp": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "streak_days": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "spin_available": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "total",
                  "streak_days",
                  "spin_available"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "recent_wins": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "symbol": {
                  "$ref": "#/$defs/symbol"
                },
                "pct": {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 1000000
                },
                "at": {
                  "$ref": "#/$defs/time"
                }
              },
              "required": [
                "symbol",
                "pct",
                "at"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 3
          }
        },
        "required": [
          "wallets",
          "ready",
          "xp",
          "recent_wins"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "scope": "yeet:read",
      "card": "home",
      "visible": true,
      "widgetAccessible": true,
      "errors": [
        "INVALID_ARGUMENT",
        "REAUTH_REQUIRED",
        "TEMPORARILY_UNAVAILABLE"
      ]
    },
    "yeet_coins": {
      "priority": "P0",
      "title": "YEET coins",
      "description": "Lists every tradable coin with its USD price, its percent change over 1, 6 and 24 hours, and the trade limits.",
      "inputSchema": {
        "$ref": "#/$defs/empty"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "coins": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "symbol": {
                  "$ref": "#/$defs/symbol"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "kind": {
                  "enum": [
                    "meme",
                    "major"
                  ]
                },
                "price_usd": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/amount"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "symbol",
                "name",
                "kind",
                "price_usd"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 25
          },
          "limits": {
            "type": "object",
            "properties": {
              "min_leg_usdc": {
                "$ref": "#/$defs/usdc"
              },
              "max_trade_usdc": {
                "$ref": "#/$defs/usdc"
              },
              "max_legs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "default_usdc": {
                "$ref": "#/$defs/usdc"
              }
            },
            "required": [
              "min_leg_usdc",
              "max_trade_usdc",
              "max_legs",
              "default_usdc"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "coins",
          "limits"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "scope": "yeet:read",
      "card": null,
      "visible": true,
      "widgetAccessible": false,
      "errors": [
        "INVALID_ARGUMENT",
        "REAUTH_REQUIRED",
        "TEMPORARILY_UNAVAILABLE"
      ]
    },
    "yeet_propose": {
      "priority": "P0",
      "title": "Quote a YEET basket",
      "description": "Quotes a YEET (buy) basket that spends USDC on 1-5 coins split by whole-number parts and shows the basket card; it buys nothing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request_id": {
            "$ref": "#/$defs/request_id"
          },
          "amount_usdc": {
            "$ref": "#/$defs/usdc"
          },
          "legs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/leg_in"
            },
            "minItems": 1,
            "maxItems": 5
          },
          "slippage_bps": {
            "type": "integer",
            "minimum": 50,
            "maximum": 300,
            "description": "Optional slippage in basis points."
          }
        },
        "required": [
          "request_id",
          "amount_usdc",
          "legs"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/proposal"
      },
      "resultMeta": {
        "yeet/confirm": {
          "$ref": "#/$defs/confirm_meta"
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "scope": "yeet:write",
      "card": "basket",
      "visible": true,
      "widgetAccessible": true,
      "errors": [
        "INVALID_ARGUMENT",
        "REAUTH_REQUIRED",
        "TEMPORARILY_UNAVAILABLE",
        "COIN_NOT_SUPPORTED",
        "PARTS_NOT_TEN",
        "AMOUNT_TOO_SMALL",
        "COST_TOO_HIGH",
        "LIMIT_EXCEEDED",
        "BALANCE_LOW",
        "WALLET_NOT_READY",
        "TRADING_PAUSED"
      ]
    },
    "yeet_quote": {
      "priority": "P0",
      "title": "Refresh a YEET quote",
      "description": "Refreshes an existing YEET or SKEET quote by proposal_id and saves it as a new revision; it trades nothing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "proposal_id": {
            "$ref": "#/$defs/proposal_id"
          },
          "legs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/leg_in"
            },
            "minItems": 1,
            "maxItems": 5
          },
          "amount_usdc": {
            "$ref": "#/$defs/usdc"
          }
        },
        "required": [
          "proposal_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/proposal"
      },
      "resultMeta": {
        "yeet/confirm": {
          "$ref": "#/$defs/confirm_meta"
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "scope": "yeet:write",
      "card": "basket",
      "visible": true,
      "widgetAccessible": true,
      "errors": [
        "INVALID_ARGUMENT",
        "REAUTH_REQUIRED",
        "TEMPORARILY_UNAVAILABLE",
        "COIN_NOT_SUPPORTED",
        "PARTS_NOT_TEN",
        "AMOUNT_TOO_SMALL",
        "COST_TOO_HIGH",
        "LIMIT_EXCEEDED",
        "BALANCE_LOW",
        "WALLET_NOT_READY",
        "TRADING_PAUSED"
      ]
    },
    "execute_trade": {
      "priority": "P0",
      "title": "Run a confirmed trade",
      "description": "Runs a quoted basket after the person taps the button in the card. Only the card can call this; it needs the one-time code the card holds.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "proposal_id": {
            "$ref": "#/$defs/proposal_id"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "confirm": {
            "$ref": "#/$defs/confirm"
          }
        },
        "required": [
          "proposal_id",
          "revision",
          "confirm"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "trade_id": {
            "$ref": "#/$defs/trade_id"
          },
          "proposal_id": {
            "$ref": "#/$defs/proposal_id"
          },
          "direction": {
            "$ref": "#/$defs/direction"
          },
          "status": {
            "enum": [
              "submitted",
              "requote_required"
            ]
          },
          "legs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "symbol": {
                  "$ref": "#/$defs/symbol"
                },
                "deposit_address": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "tx_hash": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/tx_hash"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "explorer_url": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/https_url"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "enum": [
                    "sent",
                    "failed",
                    "not_sent"
                  ]
                }
              },
              "required": [
                "symbol",
                "deposit_address",
                "tx_hash",
                "explorer_url",
                "status"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 5
          },
          "requote": {
            "$ref": "#/$defs/proposal"
          }
        },
        "required": [
          "trade_id",
          "proposal_id",
          "direction",
          "status",
          "legs"
        ],
        "additionalProperties": false
      },
      "resultMeta": {
        "yeet/confirm": {
          "$ref": "#/$defs/confirm_meta"
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "scope": "yeet:trade",
      "card": "receipt",
      "visible": false,
      "widgetAccessible": true,
      "errors": [
        "INVALID_ARGUMENT",
        "REAUTH_REQUIRED",
        "TEMPORARILY_UNAVAILABLE",
        "CONFIRMATION_REQUIRED",
        "REQUOTE_REQUIRED",
        "COST_TOO_HIGH",
        "LIMIT_EXCEEDED",
        "BALANCE_LOW",
        "WALLET_NOT_READY",
        "TRADING_PAUSED"
      ]
    },
    "trade_status": {
      "priority": "P0",
      "title": "Trade status",
      "description": "Returns the live status of a trade and what was received.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "trade_id": {
            "$ref": "#/$defs/trade_id"
          }
        },
        "required": [
          "trade_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "trade_id": {
            "$ref": "#/$defs/trade_id"
          },
          "direction": {
            "$ref": "#/$defs/direction"
          },
          "status": {
            "enum": [
              "signing",
              "submitted",
              "settling",
              "success",
              "partial",
              "refunded",
              "failed"
            ]
          },
          "legs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "symbol": {
                  "$ref": "#/$defs/symbol"
                },
                "status": {
                  "$ref": "#/$defs/swap_status"
                },
                "amount_in": {
                  "$ref": "#/$defs/amount"
                },
                "amount_out": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/amount"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "origin_tx": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/tx_hash"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "destination_tx": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/tx_hash"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "refund_reason": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "symbol",
                "status",
                "amount_in",
                "amount_out",
                "origin_tx",
                "destination_tx",
                "refund_reason"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 5
          },
          "received": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "symbol": {
                  "$ref": "#/$defs/symbol"
                },
                "amount": {
                  "$ref": "#/$defs/amount"
                }
              },
              "required": [
                "symbol",
                "amount"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 5
          },
          "updated_at": {
            "$ref": "#/$defs/time"
          },
          "xp_award": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "points": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "points",
                  "total"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "trade_id",
          "direction",
          "status",
          "legs",
          "received",
          "updated_at",
          "xp_award"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "scope": "yeet:read",
      "card": "receipt",
      "visible": true,
      "widgetAccessible": true,
      "errors": [
        "INVALID_ARGUMENT",
        "REAUTH_REQUIRED",
        "TEMPORARILY_UNAVAILABLE"
      ]
    },
    "yeet_portfolio": {
      "priority": "P1",
      "title": "YEET portfolio",
      "description": "Shows the coins and USDC the person holds on YEET, with values.",
      "inputSchema": {
        "$ref": "#/$defs/empty"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "solana": {
            "type": "object",
            "properties": {
